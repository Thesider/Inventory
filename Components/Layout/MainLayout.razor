@inherits LayoutComponentBase
@inject IAppLogger Logger
@inject AuthenticationStateProvider AuthStateProvider
@using Inventory.Components.Pages.Form
@using System.Security.Claims

<PageTitle>Inventory</PageTitle>

<div class="page">
    <div class="sidebar">
        <NavMenu />
        <div class="user-profile">
            @if (user != null)
            {
                    <div class="user-info">
                        <p>@user.Identity?.Name</p>
                    </div>
            }
        </div>
    </div>

    <main>
        <div class="top-row px-4">
            <a href="#" @onclick:preventDefault @onclick="ShowBugReportForm">Report Bug</a>
        </div>

        <div class="content px-4">
            @Body
        </div>
    </main>
</div>

@if (_isDialogVisible)
{
        <NativeDialog @ref="bugReportDialog" Title="Report a Bug" OnClose="HandleDialogClose">
            <BugReportForm @ref="bugReportForm" OnSubmitSuccess="CloseDialog" />
        </NativeDialog>
}

@code {
    private NativeDialog? bugReportDialog;
    private BugReportForm? bugReportForm;
    private bool _isDialogVisible = false;
    private ClaimsPrincipal? user;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        user = authState.User;
    }

    private void ShowBugReportForm()
    {
        _isDialogVisible = true;
        StateHasChanged();
    }

    private async Task HandleDialogClose(bool confirmed)
    {
        if (confirmed)
        {
            var success = await bugReportForm!.SubmitForm();
            if (success)
            {
                Logger.LogInformation("Bug report submitted successfully.");
            }
        }
        _isDialogVisible = false;
        StateHasChanged();
    }

    private void CloseDialog()
    {
        _isDialogVisible = false;
        StateHasChanged();
    }
}
