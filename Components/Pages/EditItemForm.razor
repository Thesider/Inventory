
<EditForm Model="@Item" OnValidSubmit="@HandleValidSubmit">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="row">
        <div class="col-md-6 mb-3">
            <label class="form-label">Item Name</label>
            <InputText class="form-control" @bind-Value="Item.ItemName" />
        </div>

        <div class="col-md-6 mb-3">
            <label class="form-label">Category</label>
            <InputSelect class="form-control" @bind-Value="Item.ItemCategory">
                @foreach (var category in Enum.GetValues(typeof(Items.Category)))
                {
                    <option value="@category">@category</option>
                }
            </InputSelect>
        </div>

        <div class="col-md-6 mb-3">
            <label class="form-label">Quantity</label>
            <InputNumber class="form-control" @bind-Value="Item.Quantity" />
        </div>

        <div class="col-md-6 mb-3">
            <label class="form-label">Price</label>
            <InputNumber class="form-control" @bind-Value="Item.RetailPrice" />
        </div>

        <div class="col-md-6 mb-3">
            <label class="form-label">Status</label>
            <InputSelect class="form-control" @bind-Value="Item.ItemStatus">
                @foreach (var status in Enum.GetValues(typeof(Items.Status)))
                {
                    <option value="@status">@status</option>
                }
            </InputSelect>
        </div>

        <div class="col-md-6 mb-3">
            <label class="form-label">Manufacturer</label>
            <InputText class="form-control" @bind-Value="Item.Manufacturer" />
        </div>

        <div class="col-md-6 mb-3">
            <label class="form-label">Origin</label>
            <InputText class="form-control" @bind-Value="Item.Origin" />
        </div>

        <div class="col-md-6 mb-3">
            <label class="form-label">Expiration Date</label>
            <InputDate class="form-control" @bind-Value="Item.ExpireDate" />
        </div>
    </div>
</EditForm>

@code {
    [Parameter]
    public Items Item { get; set; }

    private void HandleValidSubmit()
    {
        // Validation happens in parent component
    }
}