@page "/bugreport"
@inject IAppLogger Logger
@inject IJSRuntime JSRuntime

<div class="bug-report-form card shadow-sm p-4">
    <h3 class="card-title">Report a Bug</h3>
    <EditForm Model="bugLog" OnValidSubmit="HandleValidSubmit">
        <DataAnnotationsValidator />
        <ValidationSummary class="text-danger" />

        <div class="mb-3">
            <label for="message" class="form-label">Bug Description</label>
            <InputText id="message" class="form-control" @bind-Value="bugLog.Message" placeholder="Describe the bug briefly" />
        </div>
    </EditForm>

    @if (isSubmitSuccess)
    {
        <div class="alert alert-success mt-3">
            Bug report submitted successfully!
        </div>
    }
</div>

@code {
    private BugLog bugLog = new BugLog();
    private bool isSubmitSuccess = false;

    [Parameter]
    public EventCallback OnSubmitSuccess { get; set; }

    [Parameter]
    public EventCallback OnCancel { get; set; }

    public async Task HandleValidSubmit()
    {
        bugLog.DateCreated = DateTime.Now;
        await Logger.SaveBugLog(bugLog);
        bugLog = new BugLog();
        isSubmitSuccess = true;
        await OnSubmitSuccess.InvokeAsync();
        await JSRuntime.InvokeVoidAsync("showAlert", "Bug report submitted successfully!");
    }
}