@inject IItemViewModel ItemViewModel
<EditForm Model="@Item" OnValidSubmit="@HandleValidSubmit">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="row">
        <div class="col-md-6 mb-3">
            <label class="form-label">Item Name</label>
            <InputText class="form-control" @bind-Value="Item.ItemName" />
        </div>

        <div class="col-md-6 mb-3">
            <label class="form-label">Category</label>
            <InputSelect class="form-control" @bind-Value="Item.ItemCategory">
                @foreach (var category in Enum.GetValues(typeof(Category)))
                {
                    <option value="@category">@category</option>
                }
            </InputSelect>
        </div>

        <div class="col-md-6 mb-3">
            <label class="form-label">Quantity</label>
            <InputNumber class="form-control" @bind-Value="Item.Quantity" />
        </div>
        <div class="col-md-6 mb-3">
            <label class="form-label">Purchase Price</label>
            <InputNumber class="form-control" @bind-Value="Item.PurchasePrice" />
        </div>  
        <div class="col-md-6 mb-3">
            <label class="form-label">Retail Price</label>
            <InputNumber class="form-control" @bind-Value="Item.RetailPrice" />
        </div>
        <div class="col-md-6 mb-3">
            <label class="form-label">Whole Sale</label>
            <InputNumber class="form-control" @bind-Value="Item.WholesalePrice" />
        </div>
        <div class="col-md-6 mb-3">
            <label class="form-label">Manufacturer</label>
            <InputText class="form-control" @bind-Value="Item.Manufacturer" />
        </div>

        <div class="col-md-6 mb-3">
            <label class="form-label">Origin</label>
            <InputText class="form-control" @bind-Value="Item.Origin" />
        </div>
        <div class="col-md-6 mb-3">
            <label class="form-label">Alert value</label>
            <InputNumber class="form-control" @bind-Value="Item.CriticalAmmount" />
        </div>
        <div class="col-md-6 mb-3">
            <label class="form-label">Expiration Date</label>
            <InputDate class="form-control" @bind-Value="Item.ExpireDate" />
        </div>
    </div>

    <button type="submit" class="btn btn-success">Save</button>
</EditForm>

@code {
    [Parameter] public Items Item { get; set; } = new Items();
    [Parameter] public EventCallback<bool> OnClose { get; set; }

    private async Task HandleValidSubmit()
    {
        if (Item.ItemID == 0)
        {
            await ItemViewModel.AddItemAsync(Item);
        }
        else
        {
            await ItemViewModel.UpdateItemAsync(Item);
        }

        await OnClose.InvokeAsync(true);
    }
}
