@inject ISaleViewModel SaleViewModel
@using System.Globalization

<div class="card shadow-lg p-4">
    <h3 class="text-center mb-4">Sales</h3>

    <EditForm Model="SaleViewModel.SaleFormModel" OnValidSubmit="HandleProcessSale">
        <DataAnnotationsValidator />
        <ValidationSummary class="alert alert-danger" />

        <!-- Invoice Header -->
        <div class="row mb-3">
            <div class="col-md-6">
                <h5>Date: @DateTime.Now.ToString("dd MMM yyyy")</h5>
            </div>
            <div class="col-md-6 text-end">
                <h5>No: #@Guid.NewGuid().ToString().Substring(0, 8)</h5>
            </div>
        </div>

        <!-- Unit Selection -->
        <div class="mb-3">
            <label for="unit" class="form-label">Sell Unit</label>
            <select id="unit" class="form-select" @bind="SaleViewModel.SaleFormModel.Unit">
                <option value="">-- Select Unit --</option>
                @foreach (var unit in Enum.GetValues<Unit>())
                {
                        <option value="@unit">@unit</option>
                }
            </select>
        </div>

        <!-- Items Table -->
        <div class="table-responsive">
            <table class="table table-bordered text-center align-middle">
                <thead class="table-light">
                    <tr>
                        <th style="width: 5%">#</th>
                        <th style="width: 30%">Item</th>
                        <th style="width: 10%">Quantity</th>
                        <th style="width: 10%">Price</th>
                        <th style="width: 10%">Subtotal</th>
                        <th style="width: 10%">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @for (var i = 0; i < SaleViewModel.SaleFormModel.SaleItems.Count; i++)
                    {
                        var saleItem = SaleViewModel.SaleFormModel.SaleItems[i];
                        var selectedItem = SaleViewModel.Items.FirstOrDefault(it => it.ItemID == saleItem.ItemId);
                        var price = selectedItem?.RetailPrice ?? 0;
                        var subtotal = saleItem.Quantity * price;

                            <tr>
                                <td>@(i + 1)</td>
                                <td>
                                    <select class="form-select" @bind="saleItem.ItemId">
                                        <option value="0" disabled>-- Select an Item --</option>
                                    @foreach (var it in SaleViewModel.Items.Where(it => it.Quantity > 0))
                                    {
                                                <option value="@it.ItemID">@it.ItemName (@it.Quantity available)</option>
                                    }
                                    </select>
                                </td>
                                <td>
                                    <input type="number" class="form-control text-center" @bind="saleItem.Quantity" min="1" step="1" />
                                </td>
                                <td>@price.ToString("C0", new CultureInfo("vi-VN"))</td>
                                <td>@subtotal.ToString("C0", new CultureInfo("vi-VN"))</td>
                                <td>
                                    <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => SaleViewModel.RemoveSaleItem(saleItem)">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </td>
                            </tr>
                    }
                    <!-- Add New Row Button -->
                    <tr>
                        <td colspan="6" class="text-center">
                            <button type="button" class="btn btn-sm btn-outline-success" @onclick="SaleViewModel.AddSaleItem">
                                <i class="bi bi-plus-lg"></i> Add New Sale Item
                            </button>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>

        <!-- Add-On Table (Hidden by Default) -->
        @if (showAddOnsTable)
        {
                <div class="table-responsive mt-4">
                    <h5>Add-Ons</h5>
                    <table class="table table-bordered text-center align-middle">
                        <thead class="table-light">
                            <tr>
                                <th style="width: 5%">#</th>
                                <th style="width: 45%">Add-On Name</th>
                                <th style="width: 20%">Add-On Amount</th>
                                <th style="width: 10%">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                        @for (var i = 0; i < SaleViewModel.SaleFormModel.SaleItems.Count; i++)
                        {
                            var saleItem = SaleViewModel.SaleFormModel.SaleItems[i];

                                    <tr>
                                        <td>@(i + 1)</td>
                                        <td>
                                            <input type="text" class="form-control" @bind="saleItem.AddOnName" placeholder="Add-On Name" />
                                        </td>
                                        <td>
                                            <input type="number" class="form-control text-center" @bind="saleItem.AddOnAmount" step="0.01" placeholder="Add-On Amount" />
                                        </td>
                                        <td>
                                            <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => SaleViewModel.RemoveAddOn(saleItem)">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </td>
                                    </tr>
                        }
                            <!-- Add New Row Button -->
                            <tr>
                                <td colspan="4" class="text-center">
                                    <button type="button" class="btn btn-sm btn-outline-success" @onclick="SaleViewModel.AddSaleItem">
                                        <i class="bi bi-plus-lg"></i> Add New Add-On
                                    </button>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
        }

        <!-- Invoice Summary -->
        <div class="row mt-3">
            <div class="col-md-6">
                <button type="button" class="btn btn-outline-secondary ms-2" @onclick="ToggleAddOnsTable">
                    <i class="bi bi-plus-lg"></i> @(showAddOnsTable ? "Hide Add-Ons" : "Show Add-Ons")
                </button>
            </div>
            <div class="col-md-6 text-end">
                <h5>Total Quantity: <strong>@SaleViewModel.SaleFormModel.SaleItems.Sum(si => si.Quantity)</strong></h5>
                <h4>
                    Total Amount: <strong>
                        @{
                            var itemsTotal = SaleViewModel.SaleFormModel.SaleItems.Sum(si => si.Quantity * (SaleViewModel.Items.FirstOrDefault(it => it.ItemID == si.ItemId)?.RetailPrice ?? 0));
                            var addOnsTotal = SaleViewModel.SaleFormModel.SaleItems.Sum(si => si.AddOnAmount ?? 0);
                            var totalAmount = itemsTotal + addOnsTotal;
                        }
                        @totalAmount.ToString("C0", new CultureInfo("vi-VN"))
                    </strong>
                </h4>
            </div>
        </div>

        <!-- Action Buttons -->
        <div class="mt-4 text-end">
            <button type="submit" class="btn btn-primary">
                <i class="bi bi-cart-check"></i> Process Sale
            </button>
        </div>
    </EditForm>
</div>

@code {
    [Parameter]
    public EventCallback OnProcessSale { get; set; }

    private bool showAddOnsTable = false;

    private void ToggleAddOnsTable()
    {
        showAddOnsTable = !showAddOnsTable;
    }

    private async Task HandleProcessSale()
    {
        bool success = await SaleViewModel.ProcessSale();
        if (success)
        {
            await OnProcessSale.InvokeAsync();
        }
    }
}
