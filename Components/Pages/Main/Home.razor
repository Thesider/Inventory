@page "/"
@inject NavigationManager Navigation
@inject ISaleViewModel SaleViewModel
@inject IAppLogger Logger

<h3>Home</h3>

@if (SaleViewModel.InventorySummary == null || SaleViewModel.SaleFormModel == null)
{
        <div class="spinner-border" role="status"></div>
}
else
{
        <div class="row">
            <div class="col-md-6">
                <SellItemForm OnProcessSale="ProcessSale" />
            </div>
            <div class="col-md-6">
                <div class="accordion" id="accordionExample">
                    <div class="accordion-item">
                        <h2 class="accordion-header" id="headingOne">
                            <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#inventorySummaryCollapse" aria-expanded="true" aria-controls="inventorySummaryCollapse">
                                Inventory Summary
                            </button>
                        </h2>
                        <div id="inventorySummaryCollapse" class="accordion-collapse collapse show" aria-labelledby="headingOne" data-bs-parent="#accordionExample">
                            <div class="accordion-body">
                                <InventorySummaryForm InventorySummary="SaleViewModel.InventorySummary" />
                            </div>
                        </div>
                    </div>
                    <div class="accordion-item">
                        <h2 class="accordion-header" id="headingTwo">
                            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#saleHistoryCollapse" aria-expanded="false" aria-controls="saleHistoryCollapse">
                                Sale History
                            </button>
                        </h2>
                        <div id="saleHistoryCollapse" class="accordion-collapse collapse" aria-labelledby="headingTwo" data-bs-parent="#accordionExample">
                            <div class="accordion-body">
                                <SaleHistoryForm SalesHistory="SaleViewModel.SalesHistory" />
                            </div>
                        </div>
                    </div>
                    <div class="accordion-item">
                        <h2 class="accordion-header" id="headingThree">
                            <button class="accordion-button collapsed" type="button"
                                    data-bs-toggle="collapse"
                                    data-bs-target="#dailySaleReportCollapse"
                                    aria-expanded="false"
                                    aria-controls="dailySaleReportCollapse">
                                Daily Sale Report
                            </button>
                        </h2>
                        <div id="dailySaleReportCollapse" class="accordion-collapse collapse"
                             aria-labelledby="headingThree"
                             data-bs-parent="#accordionExample">
                            <div class="accordion-body">
                                <DailySaleReportForm DailySaleReport="SaleViewModel.DailySaleReport" />
                            </div>
                        </div>
                    </div>

                    <div class="accordion-item">
                        <h2 class="accordion-header" id="headingFour">
                            <button class="accordion-button collapsed" type="button"
                                    data-bs-toggle="collapse"
                                    data-bs-target="#monthlySaleReportCollapse"
                                    aria-expanded="false"
                                    aria-controls="monthlySaleReportCollapse">
                                Monthly Sale Report
                            </button>
                        </h2>
                        <div id="monthlySaleReportCollapse" class="accordion-collapse collapse"
                             aria-labelledby="headingFour"
                             data-bs-parent="#accordionExample">
                            <div class="accordion-body">
                                <MonthlySaleReportForm MonthlySalesReport="SaleViewModel.MonthlySalesReport" />
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
}

@code {
    protected override async Task OnInitializedAsync()
    {
        Logger.LogInformation("Loading home page");
        await SaleViewModel.LoadSaleData();
    }

    private async Task ProcessSale()
    {
        if (await SaleViewModel.ProcessSale())
        {
            Logger.LogInformation("Sale processed successfully.");
        }
        else
        {
            Logger.LogWarning("Failed to process sale.");
        }
    }

    private async Task HandleDialogClose(bool confirmed)
    {
        if (confirmed)
        {
            await ProcessSale();
        }
    }
}
