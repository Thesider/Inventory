@page "/"
@inject NavigationManager Navigation
@inject ISaleViewModel SaleViewModel
@inject IAppLogger Logger

<h3 style="margin-bottom: 24px;">Home</h3>
@if (SaleViewModel.InventorySummary == null || SaleViewModel.SaleFormModel == null)
{
    <div class="spinner-border" role="status"></div>
}
else
{
    <div class="row">
        <div class="col-md-8">
            <ul class="nav nav-tabs" id="myTab" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active" id="inventory-summary-tab" data-bs-toggle="tab" data-bs-target="#inventory-summary" type="button" role="tab" aria-controls="inventory-summary" aria-selected="true">Inventory Summary</button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="sale-history-tab" data-bs-toggle="tab" data-bs-target="#sale-history" type="button" role="tab" aria-controls="sale-history" aria-selected="false">Sale History</button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="daily-sale-report-tab" data-bs-toggle="tab" data-bs-target="#daily-sale-report" type="button" role="tab" aria-controls="daily-sale-report" aria-selected="false">Daily Sale Report</button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="monthly-sale-report-tab" data-bs-toggle="tab" data-bs-target="#monthly-sale-report" type="button" role="tab" aria-controls="monthly-sale-report" aria-selected="false">Monthly Sale Report</button>
                </li>
               
            </ul>
            <div class="tab-content" id="myTabContent">
                <div class="tab-pane fade show active" id="inventory-summary" role="tabpanel" aria-labelledby="inventory-summary-tab">
                    <div class="accordion-body">
                        <InventorySummaryForm InventorySummary="SaleViewModel.InventorySummary" />
                    </div>
                </div>
                <div class="tab-pane fade" id="sale-history" role="tabpanel" aria-labelledby="sale-history-tab">
                    <div class="accordion-body">
                        <SaleHistoryForm SalesHistory="SaleViewModel.SalesHistory" />
                    </div>
                </div>
                <div class="tab-pane fade" id="daily-sale-report" role="tabpanel" aria-labelledby="daily-sale-report-tab">
                    <div class="accordion-body">
                        <DailySaleReportForm DailySaleReport="SaleViewModel.DailySaleReport" />
                    </div>
                </div>
                <div class="tab-pane fade" id="monthly-sale-report" role="tabpanel" aria-labelledby="monthly-sale-report-tab">
                    <div class="accordion-body">
                        <MonthlySaleReportForm MonthlySalesReport="SaleViewModel.MonthlySalesReport" />
                    </div>
                </div>
               
            </div>
        </div>
        <div class="col-md-4">
            <ul class="nav nav-tabs" id="myTab" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active" id="sell-item-tab" data-bs-toggle="tab" data-bs-target="#sell-item" type="button" role="tab" aria-controls="sell-item" aria-selected="true">Sell Item</button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="clinic-charge-tab" data-bs-toggle="tab" data-bs-target="#clinic-charge" type="button" role="tab" aria-controls="clinic-charge" aria-selected="false">Clinic Charge</button>
                </li>
            </ul>
            <div class="tab-content" id="myTabContent">
                <div class="tab-pane fade show active" id="sell-item" role="tabpanel" aria-labelledby="sell-item-tab">
                    <SellItemForm OnProcessSale="ProcessSale" />
                </div>
                <div class="tab-pane fade" id="clinic-charge" role="tabpanel" aria-labelledby="clinic-charge-tab">
                    <div class="accordion-body">
                        <ClinicChargeForm />
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@code {
    protected override async Task OnInitializedAsync()
    {
        Logger.LogInformation("Loading home page");
        await SaleViewModel.LoadSaleData();
    }

    private async Task ProcessSale()
    {
        if (await SaleViewModel.ProcessSale())
        {
            Logger.LogInformation("Sale processed successfully.");
        }
        else
        {
            Logger.LogWarning("Failed to process sale.");
        }
    }

    private async Task HandleDialogClose(bool confirmed)
    {
        if (confirmed)
        {
            await ProcessSale();
        }
    }
}
