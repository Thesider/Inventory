@inherits ComponentBase

<div class="modal @(_isVisible ? "show d-block" : "")" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">@Title</h5>
                <button type="button" class="close" @onclick="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                @ChildContent
            </div>
            <div class="modal-footer">
                @if (ShowCancelButton)
                {
                        <button type="button" class="btn btn-secondary" @onclick="Close">Cancel</button>
                }
                <button type="button" class="btn btn-primary" @onclick="Confirm">@ConfirmButtonText</button>
            </div>
        </div>
    </div>
</div>

@code {
    private bool _isVisible = false;

    [Parameter]
    public string Title { get; set; } = "Confirmation";

    [Parameter]
    public RenderFragment ChildContent { get; set; }

    [Parameter]
    public bool ShowCancelButton { get; set; } = true;

    [Parameter]
    public string ConfirmButtonText { get; set; } = "Confirm";

    [Parameter]
    public EventCallback<bool> OnClose { get; set; }

    public void Show()
    {
        _isVisible = true;
        StateHasChanged();
    }

    public async Task Close()
    {
        _isVisible = false;
        await OnClose.InvokeAsync(false);
        StateHasChanged();
    }

    public async Task Confirm()
    {
        _isVisible = false;
        await OnClose.InvokeAsync(true);
        StateHasChanged();
    }
}